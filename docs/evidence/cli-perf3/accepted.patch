+impl<'a, W: Write> RowBuffer<'a, W> {
+    fn new(buffer: &'a mut Vec<u8>, out: &'a mut W) -> Self {
+        Self {
+            buffer,
+            out,
+            failed: false,
+            #[cfg(any(feature = "diagnostics", test))]
+            rendered_bytes: 0,
+            #[cfg(any(feature = "diagnostics", test))]
+            newlines: 0,
