+def _defer_measured_interrupt():
+    # Child exec gets setsigmask=(); only the observer's ownership handoff and
+    # final signal/reap bookkeeping defer the ordinary KeyboardInterrupt.
+    previous = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT})
+    try:
