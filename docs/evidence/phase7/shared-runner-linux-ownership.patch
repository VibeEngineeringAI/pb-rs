+@contextmanager
+def _fixture_acquisition_handoff():
+    # Unlike posix_spawn, Popen cannot reset an inherited signal mask. Defer
+    # parent SIGINT with a temporary handler, leaving the child's mask intact.
+    previous = signal.getsignal(signal.SIGINT)
+    pending = []
+    if previous is None:
+        raise RuntimeError("fixture acquisition requires a known SIGINT disposition")
+    def remember(number, frame):
+        pending[:] = [(number, frame)]
+    if previous != signal.SIG_IGN:
+        signal.signal(signal.SIGINT, remember)
+    try:
+        yield
+    finally:
+        signal.signal(signal.SIGINT, previous)
+        if pending:
+            if callable(previous):
+                previous(*pending[0])
+            else:
+                signal.raise_signal(signal.SIGINT)
